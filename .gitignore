# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
frontend/.vite/

# Job workspace — per-run scratch, never committed
workspace/jobs/*
!workspace/jobs/.gitkeep

# Synthetic benchmark renders (large)
benchmarks/renders/
benchmarks/results/

# Models / weights (large, optional VGGT)
models/weights/

# macOS
.DS_Store

# Dev-only UI test fixtures (generated by scripts/make_test_clips.sh)
frontend/public/dev-fixtures/

# Synthetic ground-truth renders — regenerate with scripts/render_synthetic.sh
benchmarks/synthetic/
benchmarks/clips/

# Real-footage test clips (third-party samples, not committed)
benchmarks/real/

# TypeScript incremental build info
*.tsbuildinfo
